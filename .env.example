# MRRmark cloud (copy to .env.local — never commit secrets)

# Neon / Postgres connection string (required for production cloud)
# Example: postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 32+ byte secret used to encrypt Stripe restricted keys at rest (required for Stripe connect)
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# Optional: Vercel Blob. If unset, files are stored under ./storage and served via API.
BLOB_READ_WRITE_TOKEN=

# Optional: Stripe Connect OAuth (future). Restricted API keys work without these.
STRIPE_CLIENT_ID=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo mode: when DATABASE_URL is empty, MRRmark uses a local JSON store in ./data/
